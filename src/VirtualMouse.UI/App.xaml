<Application x:Class="VirtualMouse.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- StartupUri is intentionally omitted. The main window is created and shown
         via dependency injection in App.xaml.cs OnStartup(), which allows
         MainWindow to receive its constructor dependencies from the DI container. -->
    <Application.Resources>
        <!-- Dark theme base -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#2D2D2D"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#007ACC"/>
        <SolidColorBrush x:Key="TextBrush" Color="#D4D4D4"/>
        <SolidColorBrush x:Key="GreenBrush" Color="#4EC94E"/>
        <SolidColorBrush x:Key="RedBrush" Color="#F44747"/>
    </Application.Resources>
</Application>

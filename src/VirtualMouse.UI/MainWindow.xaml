<Window x:Class="VirtualMouse.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Virtual Mouse v0.1 — ArduCam OV9281"
        Height="700" Width="1100"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="290"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Camera Preview -->
        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="4" Margin="0,0,10,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Camera Preview" FontSize="14" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" Margin="10,8,10,4"/>

                <Image x:Name="CameraPreviewImage" Grid.Row="1" Stretch="Uniform"
                       Margin="5" RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10,4,10,8">
                    <TextBlock Text="FPS: " Foreground="{StaticResource TextBrush}"/>
                    <TextBlock x:Name="FpsLabel" Text="--" Foreground="{StaticResource GreenBrush}" Width="40"/>
                    <TextBlock Text="Blobs: " Foreground="{StaticResource TextBrush}" Margin="20,0,0,0"/>
                    <TextBlock x:Name="BlobCountLabel" Text="--" Foreground="{StaticResource GreenBrush}" Width="30"/>
                    <TextBlock Text="Status: " Foreground="{StaticResource TextBrush}" Margin="20,0,0,0"/>
                    <TextBlock x:Name="StatusLabel" Text="Stopped" Foreground="{StaticResource RedBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Right: Controls & Calibration -->
        <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="4" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- ── Controls ── -->
                    <TextBlock Text="Controls" FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,0,10"/>

                    <!-- Camera Device Dropdown -->
                    <TextBlock Text="Camera Device:" Margin="0,0,0,3"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="CameraComboBox"
                                  Grid.Column="0"
                                  Background="#3C3C3C" Foreground="{StaticResource TextBrush}"
                                  BorderBrush="{StaticResource AccentBrush}"
                                  Padding="6,4"
                                  SelectionChanged="CameraComboBox_SelectionChanged"/>
                        <Button Grid.Column="1" Content="↻" ToolTip="Refresh camera list"
                                Margin="4,0,0,0" Padding="8,4"
                                Background="#3C3C3C" Foreground="{StaticResource TextBrush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                Click="RefreshCameras_Click" FontSize="14"/>
                    </Grid>

                    <Button x:Name="StartButton" Content="▶  Start Tracking" Margin="0,4,0,4"
                            Background="{StaticResource AccentBrush}" Foreground="White"
                            FontWeight="Bold" Padding="8,6" Click="StartButton_Click"/>
                    <Button x:Name="StopButton" Content="■  Stop Tracking" Margin="0,0,0,4"
                            Background="#555" Foreground="White" Padding="8,6"
                            IsEnabled="False" Click="StopButton_Click"/>

                    <Separator Background="#444" Margin="0,10"/>

                    <!-- ── Calibration ── -->
                    <TextBlock Text="Calibration" FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"/>

                    <!-- Brightness Threshold -->
                    <TextBlock Text="Brightness Threshold:"/>
                    <Grid Margin="0,2,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="38"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="ThresholdSlider" Grid.Column="0"
                                Minimum="100" Maximum="254" Value="200"
                                VerticalAlignment="Center"
                                ValueChanged="ThresholdSlider_ValueChanged"/>
                        <TextBlock x:Name="ThresholdLabel" Grid.Column="1"
                                   Text="200" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Mouse Sensitivity -->
                    <TextBlock Text="Mouse Sensitivity:"/>
                    <Grid Margin="0,2,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="38"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="SensitivitySlider" Grid.Column="0"
                                Minimum="0.5" Maximum="10.0" Value="2.5"
                                VerticalAlignment="Center"
                                ValueChanged="SensitivitySlider_ValueChanged"/>
                        <TextBlock x:Name="SensitivityLabel" Grid.Column="1"
                                   Text="2.5" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Pinch Threshold -->
                    <TextBlock Text="Pinch Click Threshold (px):"/>
                    <Grid Margin="0,2,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="38"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="PinchSlider" Grid.Column="0"
                                Minimum="10" Maximum="100" Value="30"
                                VerticalAlignment="Center"
                                ValueChanged="PinchSlider_ValueChanged"/>
                        <TextBlock x:Name="PinchLabel" Grid.Column="1"
                                   Text="30" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Reset Button -->
                    <Button Content="↺  Reset to Defaults" Margin="0,4,0,0"
                            Background="#6B2020" Foreground="White"
                            Padding="8,6" Click="ResetDefaults_Click"/>

                    <Separator Background="#444" Margin="0,12"/>

                    <!-- ── Marker Detection Status ── -->
                    <TextBlock Text="Marker Detection Status" FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="24"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Left Thumb (×1):" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LeftThumbStatus"  Grid.Row="0" Grid.Column="1" Text="Lost"
                                   Foreground="{StaticResource RedBrush}" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Left Index (×3):" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LeftIndexStatus"  Grid.Row="1" Grid.Column="1" Text="Lost"
                                   Foreground="{StaticResource RedBrush}" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Right Index (×3):" VerticalAlignment="Center"/>
                        <TextBlock x:Name="RightIndexStatus" Grid.Row="2" Grid.Column="1" Text="Lost"
                                   Foreground="{StaticResource RedBrush}" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Right Middle (×3):" VerticalAlignment="Center"/>
                        <TextBlock x:Name="RightMiddleStatus" Grid.Row="3" Grid.Column="1" Text="Lost"
                                   Foreground="{StaticResource RedBrush}" VerticalAlignment="Center"/>
                    </Grid>

                    <Separator Background="#444" Margin="0,12"/>
                    <TextBlock x:Name="SettingsPathLabel" FontSize="9" Foreground="#555"
                               TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock Text="v0.1.0 — Proof of Concept" FontSize="10"
                               Foreground="#666" HorizontalAlignment="Center"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>

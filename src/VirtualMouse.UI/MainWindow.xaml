<Window x:Class="VirtualMouse.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Virtual Mouse — Diagnostic"
        Height="780" Width="1200"
        Background="#1E1E1E"
        Foreground="White"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <!-- Camera preview -->
        <Border Grid.Column="0" Background="#2A2A2A" CornerRadius="4" Margin="0,0,10,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="10,8,10,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Camera Preview" Foreground="#1E90FF"
                               FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Border x:Name="StatusPill" Grid.Column="1"
                            Background="#CC3333" CornerRadius="10" Padding="12,4">
                        <TextBlock x:Name="StatusPillLabel" Text="STOPPED"
                                   FontWeight="Bold" FontSize="11" Foreground="White"/>
                    </Border>
                </Grid>

                <Image x:Name="PreviewImage" Grid.Row="1" Stretch="Uniform" Margin="5"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10,4,10,8">
                    <TextBlock Text="FPS: "/>
                    <TextBlock x:Name="FpsLabel" Text="--" Foreground="#00CC44" Width="40"/>
                    <TextBlock Text="Frames: " Margin="20,0,0,0"/>
                    <TextBlock x:Name="FrameCountLabel" Text="0" Foreground="#00CC44" Width="50"/>
                    <TextBlock Text="Blobs: " Margin="20,0,0,0"/>
                    <TextBlock x:Name="BlobCountLabel" Text="--" Foreground="#FFB800" Width="40"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Right panel -->
        <Border Grid.Column="1" Background="#2A2A2A" CornerRadius="4" Padding="12">
            <StackPanel>

                <!-- Camera selection -->
                <TextBlock Text="Camera" FontSize="13" FontWeight="Bold"
                           Foreground="#1E90FF" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="CameraComboBox" Grid.Column="0"
                              Background="#3C3C3C" Foreground="White" Padding="6,4"/>
                    <Button Grid.Column="1" Content="↻" Margin="4,0,0,0"
                            Padding="8,4" Background="#3C3C3C" Foreground="White"
                            Click="RefreshCameras_Click"/>
                </Grid>

                <Button x:Name="OpenButton" Content="▶  Open Camera"
                        Background="#1E90FF" Foreground="White" FontWeight="Bold"
                        Padding="8,6" Margin="0,0,0,4" Click="OpenCamera_Click"/>
                <Button x:Name="CloseButton" Content="■  Close Camera"
                        Background="#555" Foreground="White" Padding="8,6"
                        IsEnabled="False" Click="CloseCamera_Click"/>

                <Separator Background="#444" Margin="0,14"/>

                <!-- Stage selector -->
                <TextBlock Text="Pipeline Stage" FontSize="13" FontWeight="Bold"
                           Foreground="#1E90FF" Margin="0,0,0,6"/>
                <TextBlock TextWrapping="Wrap" Foreground="#888" FontSize="10"
                           Margin="0,0,0,10">
Select a stage, then Open Camera.
Each stage adds one more component.
The first stage that causes a black
screen is the culprit.
                </TextBlock>

                <!-- Stage buttons -->
                <Button x:Name="S0Btn" Content="Stage 0 — Raw frames only"
                        Padding="8,7" Margin="0,0,0,4" FontSize="11"
                        Background="#1A3A6B" Foreground="White"
                        Click="Stage_Click" Tag="0"/>
                <Button x:Name="S1Btn" Content="Stage 1 — CameraCapture wrapper"
                        Padding="8,7" Margin="0,0,0,4" FontSize="11"
                        Background="#3C3C3C" Foreground="White"
                        Click="Stage_Click" Tag="1"/>
                <Button x:Name="S2Btn" Content="Stage 2 — Two-thread grab loop"
                        Padding="8,7" Margin="0,0,0,4" FontSize="11"
                        Background="#3C3C3C" Foreground="White"
                        Click="Stage_Click" Tag="2"/>
                <Button x:Name="S3Btn" Content="Stage 3 — MarkerDetector (detect only)"
                        Padding="8,7" Margin="0,0,0,4" FontSize="11"
                        Background="#3C3C3C" Foreground="White"
                        Click="Stage_Click" Tag="3"/>
                <Button x:Name="S4Btn" Content="Stage 4 — Debug overlay drawn"
                        Padding="8,7" Margin="0,0,0,4" FontSize="11"
                        Background="#3C3C3C" Foreground="White"
                        Click="Stage_Click" Tag="4"/>
                <Button x:Name="S5Btn" Content="Stage 5 — Full pipeline + mouse"
                        Padding="8,7" Margin="0,0,0,4" FontSize="11"
                        Background="#3C3C3C" Foreground="White"
                        Click="Stage_Click" Tag="5"/>

                <Separator Background="#444" Margin="0,14"/>

                <!-- Active stage description -->
                <TextBlock Text="Active Stage:" FontSize="11" Foreground="#888"/>
                <Border Background="#1A1A1A" CornerRadius="4" Padding="8,6" Margin="0,4,0,0">
                    <TextBlock x:Name="StageDescLabel"
                               Text="Stage 0 — Raw VideoCapture, single thread, no processing."
                               Foreground="#AAA" FontSize="10" TextWrapping="Wrap"/>
                </Border>

            </StackPanel>
        </Border>
    </Grid>
</Window>

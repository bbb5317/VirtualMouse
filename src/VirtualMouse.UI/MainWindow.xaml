<Window x:Class="VirtualMouse.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Virtual Mouse — Camera Test"
        Height="700" Width="1100"
        Background="#1E1E1E"
        Foreground="White"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="220"/>
        </Grid.ColumnDefinitions>

        <!-- Camera preview -->
        <Border Grid.Column="0" Background="#2A2A2A" CornerRadius="4" Margin="0,0,10,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Camera Preview (raw — no processing)"
                           Foreground="#1E90FF" FontSize="13" FontWeight="Bold" Margin="10,8"/>
                <Image x:Name="PreviewImage" Grid.Row="1" Stretch="Uniform" Margin="5"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10,4,10,8">
                    <TextBlock Text="FPS: "/>
                    <TextBlock x:Name="FpsLabel" Text="--" Foreground="#00CC44" Width="40"/>
                    <TextBlock Text="Frames: " Margin="20,0,0,0"/>
                    <TextBlock x:Name="FrameCountLabel" Text="0" Foreground="#00CC44"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Controls -->
        <Border Grid.Column="1" Background="#2A2A2A" CornerRadius="4" Padding="12">
            <StackPanel>
                <TextBlock Text="Camera" FontSize="13" FontWeight="Bold"
                           Foreground="#1E90FF" Margin="0,0,0,10"/>

                <TextBlock Text="Device:" Margin="0,0,0,3"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="CameraComboBox" Grid.Column="0"
                              Background="#3C3C3C" Foreground="White"
                              Padding="6,4"/>
                    <Button Grid.Column="1" Content="↻" Margin="4,0,0,0"
                            Padding="8,4" Background="#3C3C3C" Foreground="White"
                            Click="RefreshCameras_Click"/>
                </Grid>

                <Button x:Name="StartButton" Content="▶  Open Camera"
                        Background="#1E90FF" Foreground="White" FontWeight="Bold"
                        Padding="8,6" Margin="0,4,0,4" Click="StartButton_Click"/>
                <Button x:Name="ResetUsbButton" Content="⚡  Reset USB Port"
                        Background="#7B3F00" Foreground="White" FontWeight="Bold"
                        Padding="8,6" Margin="0,4,0,0" Click="ResetUsb_Click"
                        ToolTip="Restart the camera USB device via pnputil (requires Admin)"/>
                <Button x:Name="StopButton" Content="■  Stop Tracking"
                        Background="#555" Foreground="White" Padding="8,6"
                        IsEnabled="False" Click="StopButton_Click"/>

                <Separator Background="#444" Margin="0,16"/>

                <TextBlock Text="Status" FontSize="13" FontWeight="Bold"
                           Foreground="#1E90FF" Margin="0,0,0,8"/>
                <TextBlock x:Name="StatusLabel" Text="Stopped"
                           Foreground="#CC3333" FontSize="12"/>

                <Separator Background="#444" Margin="0,16"/>
                <TextBlock TextWrapping="Wrap" Foreground="#888" FontSize="10">
DIAGNOSTIC MODE
No detection, no processing.
Raw camera frames only.
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>

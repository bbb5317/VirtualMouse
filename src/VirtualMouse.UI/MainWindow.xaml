<Window x:Class="VirtualMouse.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Virtual Mouse — Staged Diagnostic"
        Height="780" Width="1200"
        Background="#1E1E1E" Foreground="#E0E0E0"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- ── Dark ComboBox ─────────────────────────────────────────────── -->
        <SolidColorBrush x:Key="ComboBoxBg"     Color="#3C3C3C"/>
        <SolidColorBrush x:Key="ComboBoxFg"     Color="#E0E0E0"/>
        <SolidColorBrush x:Key="ComboBoxBorder" Color="#666666"/>

        <ControlTemplate x:Key="DarkComboBoxToggle" TargetType="ToggleButton">
            <Border Background="{StaticResource ComboBoxBg}"
                    BorderBrush="{StaticResource ComboBoxBorder}"
                    BorderThickness="1" CornerRadius="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="20"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Grid.Column="0" Margin="6,0,0,0"
                                      VerticalAlignment="Center"/>
                    <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z"
                          Fill="#AAAAAA" HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </ControlTemplate>

        <ControlTemplate x:Key="DarkComboBox" TargetType="ComboBox">
            <Grid>
                <ToggleButton Template="{StaticResource DarkComboBoxToggle}"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                          RelativeSource={RelativeSource TemplatedParent}}"
                              Focusable="False"/>
                <ContentPresenter Margin="8,0,24,0" VerticalAlignment="Center"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  IsHitTestVisible="False"
                                  TextBlock.Foreground="{StaticResource ComboBoxFg}"/>
                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                       Focusable="False" PopupAnimation="Slide" Placement="Bottom">
                    <Border Background="#2E2E2E" BorderBrush="#666" BorderThickness="1"
                            MaxHeight="{TemplateBinding MaxDropDownHeight}">
                        <ScrollViewer>
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Template"   Value="{StaticResource DarkComboBox}"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Height"     Value="30"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#2E2E2E"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Padding"    Value="8,4"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#1565C0"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Dark Button (enabled and disabled) ───────────────────────── -->
        <Style TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"
                                              TextBlock.FontWeight="{TemplateBinding FontWeight}"
                                              TextBlock.FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <!-- Disabled: keep background, just dim slightly -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- Camera preview -->
        <Border Grid.Column="0" Background="#2A2A2A" CornerRadius="4" Margin="0,0,10,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="10,8,10,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Camera Preview" Foreground="#4DA6FF"
                               FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Border x:Name="StatusPill" Grid.Column="1"
                            Background="#CC3333" CornerRadius="10" Padding="12,4">
                        <TextBlock x:Name="StatusPillLabel" Text="STOPPED"
                                   FontWeight="Bold" FontSize="11" Foreground="White"/>
                    </Border>
                </Grid>
                <Image x:Name="PreviewImage" Grid.Row="1" Stretch="Uniform" Margin="5"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10,4,10,8">
                    <TextBlock Text="FPS: " Foreground="#AAA"/>
                    <TextBlock x:Name="FpsLabel" Text="--" Foreground="#00CC44" Width="40"/>
                    <TextBlock Text="Frames: " Foreground="#AAA" Margin="20,0,0,0"/>
                    <TextBlock x:Name="FrameCountLabel" Text="0" Foreground="#00CC44" Width="60"/>
                    <TextBlock Text="Blobs: " Foreground="#AAA" Margin="20,0,0,0"/>
                    <TextBlock x:Name="BlobCountLabel" Text="--" Foreground="#FFB800" Width="40"/>
                    <TextBlock Text="Markers: " Foreground="#AAA" Margin="10,0,0,0"/>
                    <TextBlock x:Name="MarkerCountLabel" Text="--" Foreground="#00CC44" Width="40"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Right panel -->
        <Border Grid.Column="1" Background="#2A2A2A" CornerRadius="4" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock Text="Camera" FontSize="13" FontWeight="Bold"
                               Foreground="#4DA6FF" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="CameraComboBox" Grid.Column="0"/>
                        <Button Grid.Column="1" Content="↻" Margin="4,0,0,0"
                                Padding="8,4" Background="#4A4A4A" Foreground="#E0E0E0"
                                Click="RefreshCameras_Click" ToolTip="Refresh camera list"/>
                    </Grid>

                    <Button x:Name="OpenButton"
                            Content="▶  Open Camera"
                            Background="#1565C0" Foreground="White"
                            FontWeight="Bold" FontSize="13"
                            Padding="8,9" Margin="0,0,0,4"
                            Click="OpenCamera_Click"/>
                    <Button x:Name="CloseButton"
                            Content="■  Close Camera"
                            Background="#5A5A5A" Foreground="#E0E0E0"
                            FontSize="13" Padding="8,9"
                            IsEnabled="False" Click="CloseCamera_Click"/>

                    <Separator Background="#444" Margin="0,14"/>

                    <TextBlock Text="Pipeline Stage" FontSize="13" FontWeight="Bold"
                               Foreground="#4DA6FF" Margin="0,0,0,4"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#888" FontSize="10" Margin="0,0,0,10">
Select a stage then Open Camera.
The first stage that shows no image = the culprit.
                    </TextBlock>

                    <Button x:Name="S0Btn" Tag="0" Click="Stage_Click"
                            Content="Stage 0 — Read() direct, no processing"
                            Padding="8,8" Margin="0,0,0,3" FontSize="11"
                            Background="#1565C0" Foreground="White"/>
                    <Button x:Name="S1Btn" Tag="1" Click="Stage_Click"
                            Content="Stage 1 — CameraCapture wrapper (Read)"
                            Padding="8,8" Margin="0,0,0,3" FontSize="11"
                            Background="#3C3C3C" Foreground="#CCCCCC"/>
                    <Button x:Name="S2Btn" Tag="2" Click="Stage_Click"
                            Content="Stage 2 — CameraCapture (Grab+Retrieve)"
                            Padding="8,8" Margin="0,0,0,3" FontSize="11"
                            Background="#3C3C3C" Foreground="#CCCCCC"/>
                    <Button x:Name="S3Btn" Tag="3" Click="Stage_Click"
                            Content="Stage 3 — + MarkerDetector.Detect()"
                            Padding="8,8" Margin="0,0,0,3" FontSize="11"
                            Background="#3C3C3C" Foreground="#CCCCCC"/>
                    <Button x:Name="S4Btn" Tag="4" Click="Stage_Click"
                            Content="Stage 4 — + DrawDebug overlay"
                            Padding="8,8" Margin="0,0,0,3" FontSize="11"
                            Background="#3C3C3C" Foreground="#CCCCCC"/>
                    <Button x:Name="S5Btn" Tag="5" Click="Stage_Click"
                            Content="Stage 5 — + Gesture + Mouse injection"
                            Padding="8,8" Margin="0,0,0,3" FontSize="11"
                            Background="#3C3C3C" Foreground="#CCCCCC"/>

                    <Separator Background="#444" Margin="0,14"/>

                    <TextBlock Text="Active Stage:" FontSize="11" Foreground="#888"/>
                    <Border Background="#1A1A1A" CornerRadius="4" Padding="8,6" Margin="0,4,0,0">
                        <TextBlock x:Name="StageDescLabel"
                                   Text="Stage 0 — VideoCapture.Read() directly in MainWindow. Identical to the known-working diagnostic build."
                                   Foreground="#BBBBBB" FontSize="10" TextWrapping="Wrap"/>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
